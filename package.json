{
  "name": "17tons-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/sanitize-build-urls.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:i18n": "node tests/i18n.browser.mjs",
    "test:menus": "node tests/navigation.browser.mjs",
    "test:menus:smoke": "node tests/menus.browser.mjs",
    "test:contact": "node tests/contact.browser.mjs",
    "snapshot": "node scripts/snapshot-live-site.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1143.0",
    "playwright": "1.62.1",
    "vite": "8.0.16"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
